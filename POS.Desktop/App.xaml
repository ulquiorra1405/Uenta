<Application x:Class="POS.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:POS.Desktop.ViewModels"
             xmlns:views="clr-namespace:POS.Desktop.Views"
             xmlns:conv="clr-namespace:POS.Desktop.Converters"
             ThemeMode="Light">

    <!-- ============================================================
         Design tokens — UI/UX Pro Max (design-system/uenta-pos/MASTER.md)
         Estilo: Minimalismo Funcional (Swiss) · Densidad 6/10
         Neutros dominantes + 2 acentos configurables (Ajustes, futuro):
         Primary #059669 (acciones/selección) · Accent #EA580C (solo COBRAR).
         Regla: las vistas NUNCA hardcodean colores; usan estos recursos.
         ============================================================ -->
    <Application.Resources>
        <!-- Null/vacío → visible (mensaje de error) -->
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter" />
        <conv:IsNegativeConverter x:Key="NegConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ─── Colores ─── -->
        <!-- Acentos (los únicos colores de marca; intercambiables vía Ajustes a futuro)
             NORMA DE CONTRASTE: blanco sobre un acento SOLO si el acento da ≥4.5:1 (WCAG AA).
             PrimaryBrush/AccentBrush (#059669/#EA580C) NO cumplen para texto normal (3.8/3.6:1) →
             se usan para bordes, iconos, texto sobre claro y selección.
             PrimaryDark/AccentDark (#047857/#C2410C, 5.5/5.2:1) = relleno de botones sólidos.
             PrimaryStrong/AccentStrong (#065F46/#9A3412, 7.7/7.3:1) = hover de botones sólidos. -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#059669" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#047857" />
        <SolidColorBrush x:Key="PrimaryStrongBrush" Color="#065F46" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#D1FAE5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#EA580C" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#C2410C" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#9A3412" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFEDD5" />
        <!-- Neutros (dominantes: el color es de los acentos, no del fondo) -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="DangerLightBrush" Color="#FEE2E2" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
        <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF3C7" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#0F172A" />
        <!-- Scrim suave (40%): el foco lo pone el popup + su sombra, no el apagón.
             El zoom/fade de apertura lo maneja OverlayAnimator (Behaviors). -->
        <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />

        <!-- ─── Tipografías (fallback Segoe UI si Rubik/Nunito no están instaladas) ─── -->
        <FontFamily x:Key="DisplayFont">Rubik, Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="BodyFont">Nunito Sans, Segoe UI Variable, Segoe UI</FontFamily>

        <!-- ─── Estilos base ─── -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <!-- Botón primario OUTLINE (fondo blanco, color en borde+texto). Texto PrimaryDark (#047857,
             AA sobre blanco); borde Primary. Hover: fondo claro + borde oscuro (igual que el resto
             de botones: el feedback de interactividad es el fondo, no solo el borde). -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,10" />
            <!-- Borde SIEMPRE 2px: cambiar BorderThickness al enfocar hace que el botón crezca
                 al hacer clic (gana foco de teclado). Solo se cambia el color del borde. -->
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <!-- Focus visible (accesibilidad): solo color, nunca grosor -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de sección (Ajustes): superficie elevada con borde sutil y esquinas redondeadas. -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Botón de acento OUTLINE (COBRAR / Confirmar pago): fondo blanco, borde Accent,
             texto AccentDark (AA sobre blanco). Hover: fondo claro + borde oscuro
             (mismo patrón que el resto de botones). -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario GHOST (sin borde; hover = fondo suave) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de pago (en el panel de venta): superficie con hairline -->
        <Style x:Key="PaymentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip de selección (píldora → radius 6, coherente con botones/cards del sistema).
             Hover = fondo suave + borde Primary; seleccionado = PrimaryDark + blanco (AA). -->
        <Style x:Key="CategoryChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="6"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input -->
        <!-- Template custom SIN Margin duplicado en PART_ContentHost.
             LECCIÓN (20:13): el PART_ContentHost del TextBox ya aplica el Padding del
             TextBox internamente. Poner Margin="{TemplateBinding Padding}" en el
             ScrollViewer SUMA ambos → ~74px de offset fantasma en el texto editable,
             desalineándolo del hint superpuesto (Bryan lo vio: 'el texto editable debe
             tener algún ajuste'). El template default de WPF es la referencia correcta. -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <!-- ScrollViewer SIN Margin ni Padding: el PART_ContentHost ya
                                 aplica el Padding del TextBox internamente. Nada se suma. -->
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de sugerencia (dropdown de la línea de entrada): SIN hover propio.
             El resaltado lo maneja el ListBoxItem (IsSelected → MutedBrush, navegación
             por teclado ↑/↓). Un hover de mouse aquí duplicaría el highlight (bug reportado:
             'dos hover, el del mouse resalta mucho'). -->
        <Style x:Key="SuggestionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Solo opacidad al deshabilitar; nada en hover/pressed/foco -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card de producto: superficie + hairline, sin sombra -->
        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- ─── Overlay / popup (patrón unificado, modernizado 14-ago) ───
             OverlayScrim: Grid que cubre la app; animado por OverlayAnimator
             (fade del scrim + zoom del popup). NACE COLAPSADO: si naciera visible,
             un IsOpen=false aplicado sobre el default false no dispara el callback
             y el overlay quedaría abierto al arrancar (bug reportado 14-ago).
             Usar junto a DialogSurface. -->
        <Style x:Key="OverlayScrim" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource ScrimBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- DialogSurface: superficie del popup con sombra elevada (Blur 32 →
             sombra "floating", más moderna que la de 24). El zoom de entrada lo
             anima OverlayAnimator sobre este Border (hijo directo del scrim). -->
        <Style x:Key="DialogSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.28" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de icono compacto (cantidades − + ✕): flat, sin relleno de color fuerte -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="28" />
            <!-- Borde 1px constante transparente: el foco solo cambia el color (sin crecer) -->
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de control de la barra de título propia (min/max/close).
             Cuadrados 44x44 (área táctil), hover suave; cerrar = hover rojo. -->
        <!-- Controles de ventana: nunca retienen foco/hover tras el click (Focusable=False). -->
        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Cerrar: hover DangerLight + icono Danger (señal estándar de cierre) -->
        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerLightBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Iconos vectoriales compartidos (regla dura: sin emojis como iconos) -->
        <Geometry x:Key="SearchIcon">M21 21l-4.35-4.35 M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z</Geometry>
        <Geometry x:Key="CloseIcon">M18 6L6 18 M6 6l12 12</Geometry>
        <Geometry x:Key="PlusIcon">M12 5v14 M5 12h14</Geometry>
        <Geometry x:Key="MinusIcon">M5 12h14</Geometry>
        <Geometry x:Key="WarningIcon">M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01</Geometry>
        <Geometry x:Key="CheckIcon">M20 6 9 17l-5-5</Geometry>
        <Geometry x:Key="PercentIcon">M19 5 5 19 M6.5 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z M17.5 20a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z</Geometry>
        <Geometry x:Key="GridIcon">M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z</Geometry>
        <Geometry x:Key="BagIcon">M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z M3 6h18 M16 10a4 4 0 0 1-8 0</Geometry>
        <!-- Iconos de control de ventana (barra de título propia, estilo feather)
             Maximizar = rectángulo simple; Restaurar = dos rectángulos (copy). -->
        <Geometry x:Key="MinimizeIcon">M5 12h14</Geometry>
        <Geometry x:Key="MaximizeIcon">M4 4h16v16H4z</Geometry>
        <Geometry x:Key="RestoreIcon">M20 9h-9a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2z M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1</Geometry>

        <!-- Iconos de la barra de título (acciones): panel (sidebar) + settings (futuro) -->
        <Geometry x:Key="PanelIcon">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M12 3v18</Geometry>
