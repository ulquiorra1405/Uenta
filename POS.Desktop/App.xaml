        <!-- Estilos compartidos de la pantalla de venta (migrados de SaleView.xaml,
             P0.5: un solo hogar para los estilos; cero hex hardcodeado en vistas) -->
        <Style x:Key="MoneyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        </Style>

        <!-- Chip de método de pago (Button con selección por SelectedMethod). Radius 6 + hover con fondo. -->
        <Style x:Key="MethodChipBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MethodChipCash" TargetType="Button" BasedOn="{StaticResource MethodChipBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMethod}" Value="Cash">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MethodChipCard" TargetType="Button" BasedOn="{StaticResource MethodChipBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMethod}" Value="Card">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MethodChipTransfer" TargetType="Button" BasedOn="{StaticResource MethodChipBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMethod}" Value="Transfer">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Mapeo ViewModel → Vista (navegación por DataTemplate) -->
        <DataTemplate DataType="{x:Type vm:ProductListViewModel}">
            <views:ProductListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SaleViewModel}">
            <views:SaleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Message}" FontSize="16" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Application.Resources>
</Application>
