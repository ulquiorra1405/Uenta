<Window x:Class="POS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POS.Desktop"
        mc:Ignorable="d"
        Title="Uenta — Punto de Venta" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        MinHeight="700" MinWidth="1100">

    <Window.Resources>
        <!-- Botón de navegación del sidebar (estilo Swiss):
             activo = fondo suave + texto/icono verde + barra izquierda 3px PrimaryBrush.
             Hover = fondo MutedBrush · Press = PrimaryLightBrush · Foco = ring. -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Indicador de sección activa (barra izquierda, estilo Swiss) -->
                            <Border x:Name="Indicator" Grid.Column="0" Width="3"
                                    Background="Transparent" CornerRadius="0,2,2,0" Margin="0,5,0,5" />
                            <Border x:Name="Chrome" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Activo (lo marca el Style de cada botón vía SidebarNav.IsActive) -->
                            <DataTrigger Binding="{Binding (local:SidebarNav.IsActive), RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Colapsado: solo icono centrado -->
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0,10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Fila única que llena la ventana (sin esto, Auto se estira al contenido y el sidebar se sale por abajo) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Auto: el Border del sidebar define el ancho (210 expandido / 64 solo iconos) -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar (claro, igual paleta que el resto) -->
        <Border Grid.Column="0" Width="{Binding SidebarWidth}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <TextBlock Text="UENTA" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="20,24,0,24"
                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />

                <!-- Navegación -->
                <StackPanel Grid.Row="1" Margin="8,0">
                    <Button Command="{Binding GoCatalogCommand}" ToolTip="Catálogo"
                            AutomationProperties.Name="Catálogo">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCatalogActive}" Value="True">
                                        <Setter Property="local:SidebarNav.IsActive" Value="True" />
                                        <Setter Property="Background" Value="{StaticResource MutedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Catálogo" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding GoSalesCommand}" ToolTip="Ventas"
                            AutomationProperties.Name="Ventas">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSalesActive}" Value="True">
                                        <Setter Property="local:SidebarNav.IsActive" Value="True" />
                                        <Setter Property="Background" Value="{StaticResource MutedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Ventas" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Colapsar / expandir -->
                <Button Grid.Row="2" Command="{Binding ToggleSidebarCommand}" Margin="8,0,8,12"
                        AutomationProperties.Name="Colapsar panel">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="ToolTip" Value="Expandir panel" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <!-- El Text por defecto vive en el Style (no como valor local), para que el DataTrigger pueda cambiarlo -->
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE76B;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Text" Value="&#xE76C;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- Contenido (el DataTemplate elige la vista según el ViewModel actual) -->
        <ContentControl Grid.Column="1" Content="{Binding Current}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
