<Window x:Class="POS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Uenta — Punto de Venta" Height="640" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1F2937">
            <StackPanel Margin="0,24,0,0">
                <TextBlock Text="UENTA" Foreground="White" FontSize="26" FontWeight="Bold"
                           Margin="20,0,0,32" />
                <Button Content="📦  Catálogo" Command="{Binding GoCatalogCommand}"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"
                        Cursor="Hand" />
                <Button Content="🛒  Ventas" Command="{Binding GoSalesCommand}"
                        Background="Transparent" BorderThickness="0" Foreground="#9CA3AF"
                        HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"
                        Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- Contenido (el DataTemplate elige la vista según el ViewModel actual) -->
        <ContentControl Grid.Column="1" Content="{Binding Navigation.Current}" />
    </Grid>
</Window>
