<Window x:Class="POS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:POS.Desktop"
        xmlns:views="clr-namespace:POS.Desktop.Views"
        mc:Ignorable="d"
        Title="Uenta — Punto de Venta" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        MinHeight="700" MinWidth="1100"
        WindowStyle="None" ResizeMode="CanResize">

    <!-- Barra de título propia (control total de color → preparada para modo noche).
         WindowChrome conserva el comportamiento nativo: drag, resize, Aero Snap,
         doble clic para maximizar/restaurar. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Iconos de caja y sesión (P2.2/P2.1). Inline: sin dependencias SVG. -->
        <Geometry x:Key="WithdrawIcon">M12 1v22 M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6</Geometry>
        <Geometry x:Key="CloseCashIcon">M4 4h16v16H4z M4 10h16 M17 12h.01 M7 12h.01 M17 16h.01 M7 16h.01</Geometry>
        <Geometry x:Key="LogoutIcon">M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9</Geometry>
        <!-- Botón de navegación del sidebar (estilo Swiss).
             TODO el estado activo vive en el template (un solo hogar):
             activo = fondo PrimaryLight + texto PrimaryDark + barra izquierda 3px PrimaryBrush.
             El botón SOLO marca SidebarNav.IsActive=True (sin duplicar Background/Foreground).
             Precedencia: hover → pressed → foco → ACTIVO (el último gana).
             Borde SIEMPRE 1px (transparente en reposo): el foco solo cambia color, nunca grosor. -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Indicador de sección activa (barra izquierda, estilo Swiss) -->
                            <Border x:Name="Indicator" Grid.Column="0" Width="3"
                                    Background="Transparent" CornerRadius="0,2,2,0" Margin="0,5,0,5" />
                            <Border x:Name="Chrome" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <!-- Foco: solo color, nunca grosor (borde ya es 1px fijo) -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <!-- ACTIVO (último = mayor precedencia; prevalece sobre hover/foco) -->
                            <DataTrigger Binding="{Binding (local:SidebarNav.IsActive), RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Colapsado: solo icono centrado -->
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0,10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Barra de título propia (44px) -->
            <RowDefinition Height="44" />
            <!-- Contenido (sidebar + vista activa) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ─── Barra de título propia ─── -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Acciones de barra: toggle sidebar + settings (futuro).
                     El logo/Sección se quitó: el sidebar siempre muestra el mark Uenta
                     y cada pantalla tiene su propio título. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                    <Button AutomationProperties.Name="Colapsar panel"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ToggleSidebarCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Setter Property="ToolTip" Value="Colapsar panel" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="ToolTip" Value="Expandir panel" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource PanelIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="Configuración"
                            AutomationProperties.Name="Configuración"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding GoSettingsCommand}">
                        <Path Data="{StaticResource SettingsIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!-- Reloj (siempre visible; vivía en el header de venta) -->
                <TextBlock Grid.Column="1" Text="{Binding ClockText}" FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Grupo de sesión: caja + usuario real (P2.1c). El botón Caja abre la
                     modal de apertura cuando no hay caja; Retiro/Cierre cuando sí la hay. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">

                    <!-- Badge de caja (P2.2): abierta = verde con número; cerrada = apagada. -->
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="Estado de caja"
                            AutomationProperties.Name="EstadoCaja"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding OpenCashModalCommand}">
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6"
                                Padding="10,4" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CashTracker.HasOpen}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDarkBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Caja cerrada" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CashTracker.HasOpen}" Value="True">
                                                    <Setter Property="Text" Value="{Binding CashTracker.BadgeText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Acciones de caja (solo con caja abierta): retiro y cierre -->
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="Retiro de caja"
                            AutomationProperties.Name="RetiroCaja"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding OpenWithdrawModalCommand}"
                            Visibility="{Binding CashTracker.HasOpen, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource WithdrawIcon}"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="Cerrar caja"
                            AutomationProperties.Name="CerrarCaja"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding OpenCloseCashModalCommand}"
                            Visibility="{Binding CashTracker.HasOpen, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource CloseCashIcon}"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" />
                    </Button>

                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PrimaryBrush}"
                            Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserInitial}" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="8,0,4,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding UserName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UserRoleText, Mode=OneWay}" />
                    </TextBlock>
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="Cerrar sesión"
                            AutomationProperties.Name="CerrarSesión"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding LogoutCommand}">
                        <Path Data="{StaticResource LogoutIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="4,0,4,0"
                            VerticalAlignment="Center" />

                    <!-- Botones de control de ventana -->
                    <StackPanel Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButton}" ToolTip="Minimizar"
                                AutomationProperties.Name="Minimizar"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Minimize_Click">
                            <Path Data="{StaticResource MinimizeIcon}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" ToolTip="Maximizar" x:Name="MaxRestoreButton"
                                AutomationProperties.Name="MaximizarRestaurar"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeRestore_Click">
                            <Path x:Name="MaxRestoreIcon" Data="{StaticResource MaximizeIcon}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" ToolTip="Cerrar"
                                AutomationProperties.Name="Cerrar"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Close_Click">
                            <Path Data="{StaticResource CloseIcon}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido: sidebar + vista activa -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Fila única que llena la ventana (sin esto, Auto se estira al contenido y el sidebar se sale por abajo) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Auto: el Border del sidebar define el ancho (210 expandido / 64 solo iconos) -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- Sidebar (claro, igual paleta que el resto). Con overlay abierto se "funde"
             con el scrim: mismo fondo que la vista y sin borde derecho → el scrim (un
             solo Grid sobre todo) se ve continuo, sin línea en la frontera. -->
        <Border Grid.Column="0" Width="{Binding SidebarWidth}"
            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnyOverlayOpen}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BackgroundBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo: mark (ico.svg) + nombre. Colapsado = solo mark centrado. -->
                <StackPanel Orientation="Horizontal" Margin="16,22,16,20">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource PrimaryBrush}"
                          Width="26" Height="31" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="UENTA" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

                <!-- Navegación (ScrollViewer: blindado para cuando crezca con P2.1/P3.x) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,8,8">

                        <!-- Grupo: OPERACIÓN -->
                        <TextBlock Text="OPERACIÓN" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="14,4,0,6"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />

                        <Button Command="{Binding GoSalesCommand}" ToolTip="Ventas"
                                AutomationProperties.Name="Ventas">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSalesActive}" Value="True">
                                            <Setter Property="local:SidebarNav.IsActive" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource BagIcon}" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Ventas" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Button>

                        <!-- Grupo: GESTIÓN (sidebar dinámico P2.1d: solo lo que el rol permite) -->
                        <TextBlock Text="GESTIÓN" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="14,14,0,6"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />

                        <Button Command="{Binding GoCatalogCommand}" ToolTip="Catálogo"
                                AutomationProperties.Name="Catálogo"
                                Visibility="{Binding CanManageCatalog, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCatalogActive}" Value="True">
                                            <Setter Property="local:SidebarNav.IsActive" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GridIcon}" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Catálogo" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding GoUsersCommand}" ToolTip="Usuarios"
                                AutomationProperties.Name="Usuarios"
                                Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUsersActive}" Value="True">
                                            <Setter Property="local:SidebarNav.IsActive" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource UsersIcon}" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Usuarios" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding GoSettingsCommand}" ToolTip="Ajustes"
                                AutomationProperties.Name="Ajustes"
                                Visibility="{Binding CanManageSettings, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                            <Setter Property="local:SidebarNav.IsActive" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource SettingsIcon}" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Ajustes" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: sesión real + estado de caja (P2.1c). -->
                <StackPanel Grid.Row="2" Margin="8,0">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="6,0,6,10" />

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,12"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource PrimaryBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserInitial}" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="12.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CashTracker.HasOpen}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Caja cerrada" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CashTracker.HasOpen}" Value="True">
                                                    <Setter Property="Text" Value="{Binding CashTracker.StatusText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido (el DataTemplate elige la vista según el ViewModel actual) -->
        <ContentControl Grid.Column="1" Content="{Binding Current}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <!-- Overlays globales (popups modales). Viven aquí, a nivel del MainWindow, para que
             su scrim cubra TODO (sidebar + vista) con UNA sola pieza de color — si vivieran
             dentro de la vista, el sidebar quedaría sin oscurecer o con un scrim separado
             (línea visible entre ambos). DataContext = Current: cada popup bindea los flags
             IsXxxOpen del VM activo (y queda colapsado cuando la vista no es la suya). -->
        <views:CatalogPopupView Grid.ColumnSpan="2" DataContext="{Binding Current}" />
        <views:PaymentModalView Grid.ColumnSpan="2" DataContext="{Binding Current}" />
        <views:ResultModalView Grid.ColumnSpan="2" DataContext="{Binding Current}" />
        <views:CategoryManagerPopupView Grid.ColumnSpan="2" DataContext="{Binding Current}" />
        <views:ProductEditorPopupView Grid.ColumnSpan="2" DataContext="{Binding Current}" />
        <!-- Modales de caja: DataContext = MainWindowViewModel (el header es global, no depende de la vista). -->
        <views:CashModalsView Grid.ColumnSpan="2" />
        </Grid>
    </Grid>
</Window>
