<UserControl x:Class="POS.Desktop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:POS.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Compras" Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Text="Reposición de stock y registro del costo real (promedio ponderado)"
                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,30,0,0" />

        <!-- Error de carga -->
        <Border Grid.Row="1" Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="12,10"
                Margin="0,10,0,0"
                Visibility="{Binding LoadError, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding LoadError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Paso 1: proveedor -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="1 · Proveedor" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox Width="280" ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier}"
                                      DisplayMemberPath="Name" FontSize="13" Padding="8,7"
                                      AutomationProperties.Name="ProveedorCompra"
                                      ToolTip="Proveedor de la compra (opcional)" />
                            <Button Content="Nuevo proveedor" Style="{StaticResource SecondaryButton}" Padding="14,6"
                                    FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="NuevoProveedor"
                                    Command="{Binding OpenSupplierModalCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Paso 2: líneas de compra -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="2 · Productos a comprar" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Buscador + cantidad + costo -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox Width="220" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="8,7" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="BuscarProductoCompra"
                                     ToolTip="Busque por nombre, SKU o código de barras" />
                            <TextBox Width="60" Text="{Binding ManualQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="8,7" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="CantidadProductoCompra" />
                            <TextBox Width="80" Text="{Binding ManualCostText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="8,7" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="CostoUnitarioCompra"
                                     ToolTip="Costo unitario pagado al proveedor" />
                            <Button Content="Agregar" Style="{StaticResource SecondaryButton}" Padding="14,6"
                                    FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="AgregarProductoCompra"
                                    Command="{Binding AddLineCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedProductCostText}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding SelectedProduct, Converter={StaticResource NullToVis}}" />

                        <TextBlock Text="Busque un producto y defina cantidad y costo unitario"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"
                                   Visibility="{Binding PurchaseLines.Count, Converter={StaticResource CollectionEmptyToVis}}" />

                        <ItemsControl ItemsSource="{Binding PurchaseLines}" Margin="0,6,0,0"
                                      Visibility="{Binding PurchaseLines.Count, Converter={StaticResource CollectionNotEmptyToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PurchaseLineItem}">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ProductName}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,1,0,0">
                                                    <Run Text="Stock actual: " /><Run Text="{Binding CurrentStock, Mode=OneWay, StringFormat={}{0:0.##}}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0"
                                                        VerticalAlignment="Center">
                                                <TextBox Width="55" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12.5" Padding="6,4" VerticalContentAlignment="Center"
                                                         AutomationProperties.Name="CantidadLineaCompra" />
                                                <TextBox Width="70" Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12.5" Padding="6,4" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                                         AutomationProperties.Name="CostoLineaCompra"
                                                         ToolTip="Costo unitario (sin ITBIS)" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="12.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="QuitarLineaCompra"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource CloseIcon}" Stroke="{StaticResource DangerBrush}"
                                                      StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Error del formulario -->
                        <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="10,8"
                                Margin="0,10,0,0"
                                Visibility="{Binding FormError, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding FormError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Paso 3: total + registrar -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Total de la compra" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalText}" FontSize="32" FontWeight="Bold"
                                       FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Registrar compra" Height="44" Padding="22,0" FontSize="13.5"
                                VerticalAlignment="Center" Style="{StaticResource AccentButton}"
                                AutomationProperties.Name="RegistrarCompra"
                                Command="{Binding ProcessCommand}" />
                    </Grid>
                </Border>

                <!-- Historial -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Compras recientes" FontSize="13.5" FontWeight="SemiBold"
                                   Margin="14,12,14,4" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PurchaseHistoryItem}">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" MinWidth="150">
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <Run Text="Compra #" /><Run Text="{Binding Number, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding CreatedAtText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UserName, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding SupplierText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding LinesText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="13"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Popup resultado: compra registrada -->
        <Grid Grid.Row="2" Visibility="{Binding IsResultOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource ScrimBrush}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}"
                    Padding="28" Width="420" Background="{StaticResource SurfaceBrush}">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource PrimaryLightBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="{StaticResource CheckIcon}" Stroke="{StaticResource PrimaryBrush}"
                              StrokeThickness="3" Width="22" Height="22" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Compra registrada" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,14" Text="{Binding ResultSummaryText}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="Bold"
                               FontFamily="{StaticResource DisplayFont}" Margin="0,0,0,4"
                               Text="{Binding ResultTotalText}" />
                    <Button Content="Nueva compra" Height="42" Margin="0,18,0,0" FontSize="13.5"
                            Style="{StaticResource AccentButton}"
                            AutomationProperties.Name="NuevaCompra"
                            Command="{Binding NewPurchaseCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Popup nuevo proveedor -->
        <Grid Grid.Row="2" Visibility="{Binding IsSupplierModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource ScrimBrush}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}"
                    Padding="28" Width="440" Background="{StaticResource SurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Nuevo proveedor" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Dato maestro reutilizable en futuras compras"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,14" />

                    <TextBlock Text="Nombre *" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                             Padding="10,8" Margin="0,3,0,10" AutomationProperties.Name="NombreProveedor" />

                    <TextBlock Text="RNC (opcional)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding NewSupplierRnc, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                             Padding="10,8" Margin="0,3,0,10" AutomationProperties.Name="RncProveedor" />

                    <TextBlock Text="Teléfono" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding NewSupplierPhone, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                             Padding="10,8" Margin="0,3,0,0" AutomationProperties.Name="TelefonoProveedor" />

                    <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="10,8"
                            Margin="0,10,0,0"
                            Visibility="{Binding SupplierError, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding SupplierError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="10,8"
                            Margin="0,10,0,0"
                            Visibility="{Binding SupplierMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding SupplierMessage}" FontSize="12" Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Padding="16,8" FontSize="13"
                                AutomationProperties.Name="CancelarProveedor"
                                Command="{Binding CloseSupplierModalCommand}" />
                        <Button Content="Guardar" Style="{StaticResource AccentButton}" Padding="16,8" FontSize="13"
                                Margin="8,0,0,0" AutomationProperties.Name="GuardarProveedor"
                                Command="{Binding SaveSupplierCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>