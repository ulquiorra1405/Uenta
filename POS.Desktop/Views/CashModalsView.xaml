<UserControl x:Class="POS.Desktop.Views.CashModalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:beh="clr-namespace:POS.Desktop.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="480">

    <Grid>
        <!-- Resultado del último cierre (toast no bloqueante; se limpia con X). -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                Visibility="{Binding LastCloseResult, Converter={StaticResource NullToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LastCloseResult}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Padding="6,2"
                        AutomationProperties.Name="CerrarResultadoCaja"
                        Command="{Binding ClearLastCloseResultCommand}">
                    <Path Data="{StaticResource CloseIcon}" Stroke="{StaticResource DangerBrush}"
                          StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Apertura de caja -->
        <Grid Style="{StaticResource OverlayScrim}" beh:OverlayAnimator.IsOpen="{Binding IsCashOpenModal}">
            <Border Style="{StaticResource DialogSurface}" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Abrir caja" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="Registre el efectivo inicial del turno."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" />

                    <TextBlock Text="Efectivo inicial (RD$)" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding OpenCashText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="MontoAperturaCaja"
                             FontSize="22" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                             Padding="12,9" Margin="0,4,0,0" ToolTip="Fondo inicial de la caja (0 si no hay)" />

                    <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding CashError, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding CashError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Cancelar"
                                Command="{Binding CloseCashModalCommand}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Abrir caja"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding ConfirmOpenCashCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Retiro de caja -->
        <Grid Style="{StaticResource OverlayScrim}" beh:OverlayAnimator.IsOpen="{Binding IsWithdrawModalOpen}">
            <Border Style="{StaticResource DialogSurface}" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Retiro de caja" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="Saque efectivo de la caja (gastos, cambio, etc.). El motivo es obligatorio."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,14" />

                    <TextBlock Text="Monto (RD$)" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding WithdrawAmountText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="MontoRetiroCaja"
                             FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                             Padding="12,9" Margin="0,4,0,10" />

                    <TextBlock Text="Motivo" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding WithdrawReason, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="MotivoRetiroCaja"
                             FontSize="14" Padding="12,8" Margin="0,4,0,0"
                             ToolTip="Ej.: pago a proveedor, cambio para la calle" />

                    <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding CashError, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding CashError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Cancelar"
                                Command="{Binding CloseWithdrawModalCommand}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Confirmar retiro"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding ConfirmWithdrawCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cierre de caja -->
        <Grid Style="{StaticResource OverlayScrim}" beh:OverlayAnimator.IsOpen="{Binding IsCloseCashModalOpen}">
            <Border Style="{StaticResource DialogSurface}" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Cerrar caja" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="Cuente el efectivo físico y registre el total. La diferencia se calcula contra el esperado."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Efectivo esperado" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CashTracker.Current.ExpectedCash, StringFormat=RD$ {0:N2}}"
                                       FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Efectivo en caja" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CashTracker.Current.CashSalesTotal, StringFormat=RD$ {0:N2}}"
                                       FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Conteo físico (RD$)" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding CloseCountText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="ConteoFisicoCaja"
                             FontSize="22" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                             Padding="12,9" Margin="0,4,0,0"
                             ToolTip="Total de efectivo contado en la caja" />

                    <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding CashError, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding CashError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Cancelar"
                                Command="{Binding CloseCloseCashModalCommand}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Cerrar caja"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding ConfirmCloseCashCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>