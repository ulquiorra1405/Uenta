<UserControl x:Class="POS.Desktop.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Catálogo de productos"
                   FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- Barra de búsqueda -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" VerticalContentAlignment="Center"
                     ToolTip="Buscar por nombre, SKU o código de barras" />
            <Button Grid.Column="1" Content="Buscar" Command="{Binding SearchCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="16,6" />
            <Button Grid.Column="2" Content="+ Nuevo producto" Command="{Binding NewCommand}"
                    Margin="8,0,0,0" Padding="16,6" FontWeight="SemiBold" />
        </Grid>

        <!-- Tabla de productos -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" HeadersVisibility="Column"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" />
                <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryName}" Width="110" />
                <DataGridTextColumn Header="Precio (RD$)" Binding="{Binding Price.Amount, StringFormat={}{0:N2}}" Width="110" />
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat={}{0:N0}}" Width="80" />
                <DataGridTextColumn Header="Min." Binding="{Binding MinStock, StringFormat={}{0:N0}}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Barra de acciones -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Editar" Command="{Binding EditCommand}" Padding="16,6"
                        Style="{StaticResource SecondaryButton}" />
                <Button Content="Desactivar" Command="{Binding DeactivateCommand}" Padding="16,6" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Foreground="{StaticResource DangerBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
