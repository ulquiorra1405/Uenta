<UserControl x:Class="POS.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ajustes" Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left">

                <!-- Impresora -->
                <TextBlock Text="IMPRESORA" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" />
                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Impresora térmica" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="El recibo se envía a esta impresora (ESC/POS 80mm)."
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,10" />
                        <ComboBox ItemsSource="{Binding PrinterOptions}"
                                  SelectedItem="{Binding PrinterName}"
                                  FontSize="13" Padding="8,6" MaxWidth="420"
                                  AutomationProperties.Name="SelectorImpresora" />
                        <CheckBox Content="Imprimir el recibo automáticamente al cobrar"
                                  IsChecked="{Binding AutoPrint}"
                                  FontSize="12.5" Margin="0,12,0,0"
                                  AutomationProperties.Name="AutoImprimir" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Copias:" FontSize="12.5" VerticalAlignment="Center" />
                            <ComboBox SelectedIndex="{Binding Copies}" MinWidth="70" Margin="8,0,0,0"
                                      FontSize="13" Padding="6,4"
                                      AutomationProperties.Name="NumeroCopias">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="6" />
                                <ComboBoxItem Content="7" />
                                <ComboBoxItem Content="8" />
                                <ComboBoxItem Content="9" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Datos del negocio -->
                <TextBlock Text="DATOS DEL NEGOCIO" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,8" />
                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Nombre" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="8,7" Margin="0,4,0,10" MaxWidth="420"
                                 AutomationProperties.Name="NombreNegocio" />
                        <TextBlock Text="RNC" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding BusinessRnc, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="8,7" Margin="0,4,0,10" MaxWidth="420"
                                 AutomationProperties.Name="RncNegocio" />
                        <TextBlock Text="Dirección" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding BusinessAddress, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="8,7" Margin="0,4,0,10" MaxWidth="420"
                                 AutomationProperties.Name="DireccionNegocio" />
                        <TextBlock Text="Pie de recibo" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="8,7" Margin="0,4,0,0" MaxWidth="420"
                                 AutomationProperties.Name="PieRecibo" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding SaveMessage}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,14,0,0"
                           Visibility="{Binding SaveMessage, Converter={StaticResource NullToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Guardar" Height="42" Padding="28,0" FontSize="14"
                    Style="{StaticResource AccentButton}"
                    AutomationProperties.Name="GuardarAjustes"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>