<UserControl x:Class="POS.Desktop.Views.CustomersPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:POS.Desktop.ViewModels"
             xmlns:beh="clr-namespace:POS.Desktop.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="540">

    <!-- Overlay global: crear cliente. Vive en el MainWindow para que su scrim
         cubra sidebar + vista (patrón unificado de overlays). -->
    <Grid>
        <Grid Style="{StaticResource OverlayScrim}"
              beh:OverlayAnimator.IsOpen="{Binding IsCreateOpen}">
        <Border Style="{StaticResource DialogSurface}" Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
            <StackPanel>
                <TextBlock Text="Nuevo cliente" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Text="Nombre *" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" Padding="8,7" Margin="0,3,0,10"
                         AutomationProperties.Name="NuevoClienteNombre" />
                <TextBlock Text="Teléfono" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" Padding="8,7" Margin="0,3,0,10"
                         AutomationProperties.Name="NuevoClienteTelefono" />
                <TextBlock Text="RNC / Cédula" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding NewRncCedula, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" Padding="8,7" Margin="0,3,0,10"
                         AutomationProperties.Name="NuevoClienteRnc" />
                <TextBlock Text="Correo" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" Padding="8,7" Margin="0,3,0,12"
                         AutomationProperties.Name="NuevoClienteEmail" />

                <TextBlock Text="{Binding CreateError}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Visibility="{Binding CreateError, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding CreateMessage}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding CreateMessage, Converter={StaticResource NullToVis}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Padding="18,8" FontSize="13"
                            Command="{Binding CloseCreateCommand}" />
                    <Button Content="Registrar" Style="{StaticResource AccentButton}" Padding="18,8" FontSize="13"
                            Margin="8,0,0,0" AutomationProperties.Name="RegistrarCliente"
                            Command="{Binding CreateCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Overlay global: historial de compras del cliente. -->
        <Grid Style="{StaticResource OverlayScrim}"
              beh:OverlayAnimator.IsOpen="{Binding IsHistoryOpen}">
        <Border Style="{StaticResource DialogSurface}" Width="520"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Historial de " FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HistoryCustomerName}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}" />
                </StackPanel>
                <TextBlock Text="Compras registradas del cliente" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                <TextBlock Text="{Binding HistoryMessage}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding HistoryMessage, Converter={StaticResource NullToVis}}" />

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        MaxHeight="320">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HistorySales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CustomerSaleListItem}">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="10,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                           Text="{Binding Number, StringFormat=Recibo #\{0\}}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding MetaText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="13"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cerrar" Style="{StaticResource SecondaryButton}" Padding="18,8" FontSize="13"
                            AutomationProperties.Name="CerrarHistorial"
                            Command="{Binding CloseHistoryCommand}" />
                </StackPanel>
            </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>