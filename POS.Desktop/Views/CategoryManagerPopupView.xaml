<UserControl x:Class="POS.Desktop.Views.CategoryManagerPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:beh="clr-namespace:POS.Desktop.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="420">

    <!-- Overlay global: gestor de categorías (crear + renombrar inline).
         Vive en el MainWindow para que su scrim cubra sidebar + vista. -->
    <Grid Style="{StaticResource OverlayScrim}"
          beh:OverlayAnimator.IsOpen="{Binding IsCategoryManagerOpen}">
        <Border Style="{StaticResource DialogSurface}" Width="420"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Categorías" Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Cerrar (Esc)"
                            AutomationProperties.Name="CerrarCategorias"
                            Command="{Binding CloseCategoryManagerCommand}">
                        <Path Data="{StaticResource CloseIcon}" Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- Renombrar inline -->
                <TextBlock Text="Renombrar" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Categories}" BorderThickness="0" Background="Transparent"
                         MaxHeight="240" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" Padding="0">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10,7" FontSize="12.5" AutomationProperties.Name="NombreCategoria" />
                                    <TextBlock FontSize="10.5" Margin="4,3,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"
                                                        Value="{Binding ProductCount, StringFormat={}{0} producto(s)}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text"
                                                                Value="{Binding ProductCount, StringFormat={}{0} producto(s) · Inactiva}" />
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Top" Margin="6,0,0,0"
                                        Style="{StaticResource IconButton}" ToolTip="Guardar nombre"
                                        AutomationProperties.Name="GuardarCategoria"
                                        Command="{Binding DataContext.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Path Data="{StaticResource CheckIcon}" Stroke="{StaticResource PrimaryBrush}"
                                          StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" />
                                </Button>
                                <!-- Desactivar (solo activa) -->
                                <Button Grid.Column="2" VerticalAlignment="Top" Margin="4,0,0,0"
                                        ToolTip="Desactivar categoría"
                                        AutomationProperties.Name="DesactivarCategoria"
                                        Command="{Binding DataContext.DeactivateCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path Data="{StaticResource PowerIcon}" Stroke="{StaticResource DangerBrush}"
                                          StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" />
                                </Button>
                                <!-- Reactivar (solo inactiva) -->
                                <Button Grid.Column="2" VerticalAlignment="Top" Margin="4,0,0,0"
                                        ToolTip="Reactivar categoría"
                                        AutomationProperties.Name="ReactivarCategoria"
                                        Command="{Binding DataContext.ReactivateCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path Data="{StaticResource PowerIcon}" Stroke="{StaticResource PrimaryBrush}"
                                          StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Crear nueva -->
                <TextBlock Text="Nueva categoría" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,7" FontSize="12.5"
                             AutomationProperties.Name="NuevaCategoriaNombre" />
                    <Button Grid.Column="1" Content="Crear" Margin="8,0,0,0" Padding="16,8"
                            Command="{Binding CreateCategoryCommand}" FontWeight="SemiBold" />
                </Grid>

                <Button Content="Listo" Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CloseCategoryManagerCommand}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
