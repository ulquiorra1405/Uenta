<UserControl x:Class="POS.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Marca -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource LogoGeometry}" Fill="{StaticResource PrimaryBrush}"
                      Width="34" Height="40" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="UENTA" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0"
                           FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Punto de Venta" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,28" />

            <!-- Tarjeta de login -->
            <Border Style="{StaticResource CardBorder}" Padding="24,22">
                <StackPanel>
                    <TextBlock Text="Iniciar sesión" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="Usuario" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="9,8" Margin="0,4,0,12"
                             AutomationProperties.Name="LoginUsuario"
                             KeyDown="Username_KeyDown" />

                    <TextBlock Text="Contraseña" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <PasswordBox x:Name="PasswordInput"
                                 FontSize="14" Padding="9,8" Margin="0,4,0,16"
                                 AutomationProperties.Name="LoginContrasena"
                                 PasswordChanged="Password_Changed"
                                 KeyDown="Password_KeyDown" />

                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />

                    <Button Content="Entrar" Height="44" FontSize="14"
                            Style="{StaticResource AccentButton}"
                            AutomationProperties.Name="Entrar"
                            Command="{Binding LoginCommand}" />

                    <TextBlock Text="Admin: admin/admin123 · Supervisor: super123 · Cajero: cajero123"
                               FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>