<UserControl x:Class="POS.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:POS.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Usuarios" Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Nuevo usuario" Height="40" Padding="20,0" FontSize="13.5"
                        Style="{StaticResource AccentButton}"
                        AutomationProperties.Name="NuevoUsuario"
                        Command="{Binding OpenCreateCommand}" />
            </StackPanel>
            <!-- Error de carga (visible, no solo en el popup) -->
            <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="12,10"
                    Margin="0,10,0,0"
                    Visibility="{Binding CreateError, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding CreateError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Lista -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Users}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UserListItem}">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="14,10">
                                <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" />
                                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="4"
                                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RoleText}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryDarkBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource MutedBrush}" CornerRadius="4"
                                                    Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="SESIÓN ACTUAL" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="INACTIVO" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Username, StringFormat=@{0}}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Message}" FontSize="11.5"
                                                   Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Acciones (ocultas para la sesión actual) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Editar" Style="{StaticResource SecondaryButton}"
                                                Padding="12,5" FontSize="12"
                                                AutomationProperties.Name="EditarUsuario"
                                                Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Reset clave" Style="{StaticResource SecondaryButton}"
                                                Padding="12,5" FontSize="12" Margin="6,0,0,0"
                                                AutomationProperties.Name="ResetClave"
                                                Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Padding="12,5" FontSize="12" Margin="6,0,0,0"
                                                AutomationProperties.Name="ActivarDesactivar"
                                                Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Content" Value="Desactivar" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Content" Value="Activar" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Expander IsExpanded="{Binding IsEditing}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Margin="14,6,14,12">
                                        <TextBlock Text="Nombre para mostrar" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" Padding="8,6" Margin="0,3,0,8" MaxWidth="320"
                                                 AutomationProperties.Name="NombreMostrar" />
                                        <TextBlock Text="Rol" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding DataContext.RoleOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding EditRoleOption}"
                                                  DisplayMemberPath="Label" FontSize="13" Padding="8,6"
                                                  Margin="0,3,0,10" MaxWidth="320"
                                                  AutomationProperties.Name="RolUsuario" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Guardar" Style="{StaticResource AccentButton}"
                                                    Padding="16,6" FontSize="12.5"
                                                    AutomationProperties.Name="GuardarUsuario"
                                                    Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                                                    Padding="16,6" FontSize="12.5" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Popup crear usuario -->
        <Grid Grid.Row="2" Visibility="{Binding IsCreateOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource ScrimBrush}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}"
                    Padding="24" Width="400" Background="{StaticResource SurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Nuevo usuario" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="Usuario" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="8,7" Margin="0,3,0,10"
                             AutomationProperties.Name="NuevoUsuarioNombre" />
                    <TextBlock Text="Nombre para mostrar" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="8,7" Margin="0,3,0,10"
                             AutomationProperties.Name="NuevoUsuarioMostrar" />
                    <TextBlock Text="Contraseña (mín. 6 caracteres)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <PasswordBox x:Name="NewPasswordBox" FontSize="13" Padding="8,7" Margin="0,3,0,10"
                                 AutomationProperties.Name="NuevoUsuarioContrasena"
                                 KeyDown="NewPassword_KeyDown" />
                    <TextBlock Text="Rol" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedNewRole}"
                              DisplayMemberPath="Label" FontSize="13" Padding="8,6" Margin="0,3,0,12"
                              AutomationProperties.Name="RolNuevoUsuario" />

                    <TextBlock Text="{Binding CreateError}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Visibility="{Binding CreateError, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding CreateMessage}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding CreateMessage, Converter={StaticResource NullToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Padding="18,8" FontSize="13"
                                Command="{Binding CloseCreateCommand}" />
                        <Button Content="Crear usuario" Style="{StaticResource AccentButton}" Padding="18,8" FontSize="13"
                                Margin="8,0,0,0" AutomationProperties.Name="CrearUsuario"
                                Command="{Binding CreateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>