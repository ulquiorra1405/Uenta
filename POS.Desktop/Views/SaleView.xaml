<UserControl x:Class="POS.Desktop.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:POS.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1280">

    <UserControl.InputBindings>
        <KeyBinding Key="F8" Command="{Binding CobrarCommand}" />
        <KeyBinding Key="F9" Command="{Binding SetExactAmountCommand}" />
        <KeyBinding Key="F2" Command="{Binding OpenCatalogCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelOverlayCommand}" />
    </UserControl.InputBindings>

    <!-- Cascarón delgado (P0.2): cada zona vive en su propio UserControl. -->
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Cuerpo: ticket (izq) | cobro (der) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40*" />
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: TICKET -->
            <Grid Grid.Column="0" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Encabezado venta -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VENTA NUEVA" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Cliente:" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding CustomerOptions}"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Label" FontSize="12" Padding="8,3"
                                      MinWidth="140" MaxWidth="240" Margin="6,0,0,0"
                                      VerticalContentAlignment="Center"
                                      AutomationProperties.Name="ClienteVenta" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock AutomationProperties.Name="{Binding CartLines.Count, StringFormat={}{0}}"
                                   Text="{Binding CartLines.Count, StringFormat={}{0} líneas}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </Grid>

                <views:TicketLinesView Grid.Row="1" />
                <views:TicketEntryView Grid.Row="2" />
            </Grid>

            <!-- Separador -->
            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="0,8" />

            <!-- Columna derecha: COBRO -->
            <views:TotalsPanelView Grid.Column="2" Margin="16,16,16,14" />
        </Grid>
    </Grid>
</UserControl>