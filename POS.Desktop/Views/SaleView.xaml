<UserControl x:Class="POS.Desktop.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:POS.Domain.Enums;assembly=POS.Domain"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1280"
             FocusManager.FocusedElement="{Binding ElementName=SearchBox}">

    <UserControl.Resources>
        <!-- Iconos vectoriales (regla: sin emojis) -->
        <Geometry x:Key="SearchIcon">M21 21l-4.35-4.35 M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z</Geometry>
        <Geometry x:Key="CloseIcon">M18 6L6 18 M6 6l12 12</Geometry>
        <Geometry x:Key="PlusIcon">M12 5v14 M5 12h14</Geometry>
        <Geometry x:Key="MinusIcon">M5 12h14</Geometry>
        <Geometry x:Key="WarningIcon">M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01</Geometry>
        <Geometry x:Key="CheckIcon">M20 6 9 17l-5-5</Geometry>
        <Geometry x:Key="PercentIcon">M19 5 5 19 M6.5 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z M17.5 20a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z</Geometry>
        <Geometry x:Key="GridIcon">M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z</Geometry>

        <Style x:Key="MoneyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        </Style>

        <!-- Chip de método de pago (Button con píldora + estado activo por SelectedMethod) -->
        <Style x:Key="MethodChipBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="999"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MethodChipCash" TargetType="Button" BasedOn="{StaticResource MethodChipBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMethod}" Value="Cash">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MethodChipCard" TargetType="Button" BasedOn="{StaticResource MethodChipBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMethod}" Value="Card">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MethodChipTransfer" TargetType="Button" BasedOn="{StaticResource MethodChipBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMethod}" Value="Transfer">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F8" Command="{Binding CobrarCommand}" />
        <KeyBinding Key="F9" Command="{Binding SetExactAmountCommand}" />
        <KeyBinding Key="F2" Command="{Binding OpenCatalogCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelOverlayCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- ═══════════ Header contextual ═══════════ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ventas" FontSize="16" FontWeight="Bold"
                               FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="999"
                            Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource PrimaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Caja abierta (demo)" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="ClockText" Text="--:--" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource PrimaryBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Cajero demo" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Cuerpo: ticket (izq) | cobro (der) ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40*" />
            </Grid.ColumnDefinitions>

            <!-- ─────────── Columna izquierda: TICKET ─────────── -->
            <Grid Grid.Column="0" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Encabezado venta -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VENTA NUEVA" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Cliente: Anónimo" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                   ToolTip="El registro de clientes llega en un próximo incremento." />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CartLines.Count, StringFormat={}{0} líneas}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </Grid>

                <!-- Líneas del ticket -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CartLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                                    <Run Text="{Binding Quantity, StringFormat={}{0:N0}×}" FontWeight="Bold" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Name}" />
                                                </TextBlock>
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding UnitPrice, StringFormat=RD$ {0:N2}}" />
                                                    <Run Text=" c/u" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Descuento aplicado -->
                                                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6"
                                                        Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LineDiscount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryDarkBrush}">
                                                        <Run Text="-RD$ " />
                                                        <Run Text="{Binding LineDiscount, StringFormat={}{0:N2}}" />
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding LineTotal, StringFormat=RD$ {0:N2}}"
                                                           Style="{StaticResource MoneyText}" FontSize="14" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" ToolTip="Disminuir"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource MinusIcon}" Stroke="{StaticResource TextPrimaryBrush}"
                                                          StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="Aumentar" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource PlusIcon}" Stroke="{StaticResource TextPrimaryBrush}"
                                                          StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="Descuento de línea" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.ToggleLineDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource PercentIcon}" Stroke="{StaticResource TextPrimaryBrush}"
                                                          StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource IconButton}" ToolTip="Quitar línea"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource CloseIcon}" Stroke="{StaticResource DangerBrush}"
                                                          StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Descuento inline -->
                                        <Grid Margin="0,6,0,0" Visibility="{Binding IsDiscountOpen, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding DiscountPercentText, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,5" FontSize="12" ToolTip="Porcentaje de descuento" />
                                            <Button Grid.Column="1" Content="Aplicar" Margin="6,0,0,0" Padding="12,5" FontSize="12"
                                                    Command="{Binding DataContext.ApplyLineDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Línea de entrada (corazón del modelo B) + catálogo a demanda -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="38,11,12,11" FontSize="14"
                                 ToolTip="Escanee un código de barras o escriba SKU/nombre (Enter agrega)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddFromSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Path Data="{StaticResource SearchIcon}" Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="2" Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Left" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Escribe código o nombre…  (Enter agrega)" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="38,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1" Content="Catálogo  (F2)" Margin="8,0,0,0" Padding="16,8"
                            Style="{StaticResource SecondaryButton}" Command="{Binding OpenCatalogCommand}"
                            AutomationProperties.Name="AbrirCatalogo">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GridIcon}" Stroke="{StaticResource TextPrimaryBrush}"
                                          StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Catálogo  (F2)" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>
            </Grid>

            <!-- Separador -->
            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="0,8" />

            <!-- ─────────── Columna derecha: COBRO ─────────── -->
            <Grid Grid.Column="2" Margin="16,16,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Aviso stock -->
                <Border Grid.Row="0" Background="{StaticResource WarningLightBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLowStockWarnings}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource WarningIcon}" Stroke="{StaticResource WarningBrush}"
                              StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Hay productos que superan el stock disponible. Se venderán igual (aviso no bloqueante)."
                                   FontSize="11" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Totales -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subtotal, StringFormat=RD$ {0:N2}}" FontSize="13" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ITBIS 18% (incluido)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Itbis, StringFormat=RD$ {0:N2}}" FontSize="13" Margin="0,4,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Descuento global" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GlobalDiscount, UpdateSourceTrigger=PropertyChanged}"
                                     Width="110" Padding="6,3" FontSize="12" HorizontalContentAlignment="Right"
                                     ToolTip="Descuento global en RD$ (tope por rol en un próximo incremento)" Margin="0,4,0,0" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL" FontSize="16" FontWeight="Bold"
                                       FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=RD$ {0:N2}}"
                                       FontSize="26" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Métodos de pago -->
                <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,8">
                    <Button Style="{StaticResource PaymentButton}" Content="EFECTIVO" Margin="0,0,4,4"
                            Command="{Binding CobrarCommand}" />
                    <Button Style="{StaticResource PaymentButton}" Content="TARJETA" Margin="4,0,0,4"
                            Command="{Binding SetMethodCommand}" CommandParameter="{x:Static enums:PaymentMethod.Card}" />
                    <Button Style="{StaticResource PaymentButton}" Content="TRANSFERENCIA" Margin="0,4,4,0"
                            Command="{Binding SetMethodCommand}" CommandParameter="{x:Static enums:PaymentMethod.Transfer}" />
                    <Button Style="{StaticResource PaymentButton}" Content="MIXTO" Margin="4,4,0,0"
                            Command="{Binding OpenMixedCommand}" />
                </UniformGrid>

                <!-- COBRAR -->
                <Button Grid.Row="3" Content="COBRAR  (F8)" Height="52" FontSize="17"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        Command="{Binding CobrarCommand}" />
            </Grid>
        </Grid>

        <!-- ═══════════ Overlay: catálogo visual (F2, agrega sin cerrar) ═══════════ -->
        <Grid x:Name="CatalogOverlay" Grid.RowSpan="2" Background="{StaticResource ScrimBrush}"
              Visibility="{Binding IsCatalogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Width="780" Height="580"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Título + cerrar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Catálogo" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="  —  agregar no cierra (F2)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Cerrar (Esc)"
                                Command="{Binding CloseCatalogCommand}" AutomationProperties.Name="CerrarCatalogo">
                            <Path Data="{StaticResource CloseIcon}" Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Buscador del catálogo -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="CatalogSearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="38,10,12,10" FontSize="14"
                                 ToolTip="Escanee un código de barras o escriba SKU/nombre">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddFromSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Path Data="{StaticResource SearchIcon}" Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="2" Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Left" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <!-- Categorías -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,10" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource CategoryChip}" Content="{Binding Name}"
                                                  Margin="0,0,6,0" IsChecked="{Binding IsSelected}"
                                                  Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Grid de productos -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCard}" Width="176" Margin="0,0,10,10"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                               TextWrapping="Wrap" MaxHeight="36" />
                                                    <TextBlock Text="{Binding Sku}" FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <!-- Badge stock bajo -->
                                                <Border Background="{StaticResource WarningLightBrush}" CornerRadius="999"
                                                        Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LowStock}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Stock bajo" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="{StaticResource WarningBrush}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Price.Amount, StringFormat=RD$ {0:N2}}"
                                                       Style="{StaticResource MoneyText}" FontSize="16" Margin="0,8,0,0" />

                                            <Button Grid.Row="2" Content="+ AGREGAR" Margin="0,8,0,0" FontSize="11.5"
                                                    Padding="0,7"
                                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CatalogStatus}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Cerrar  (Esc)" Padding="16,8"
                                Style="{StaticResource SecondaryButton}" Command="{Binding CloseCatalogCommand}"
                                AutomationProperties.Name="CerrarCatalogo"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ Overlay: cobro ═══════════ -->
        <Grid Grid.RowSpan="2" Background="{StaticResource ScrimBrush}"
              Visibility="{Binding IsPaymentOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Cobrar venta" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                    <TextBlock FontSize="32" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                               Margin="0,0,0,16">
                        <Run Text="RD$ " /><Run Text="{Binding Total, StringFormat={}{0:N2}}" />
                    </TextBlock>

                    <!-- Selector de método -->
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Button Style="{StaticResource MethodChipCash}" Content="Efectivo" Margin="0,0,4,0"
                                Command="{Binding SetMethodCommand}" CommandParameter="{x:Static enums:PaymentMethod.Cash}" />
                        <Button Style="{StaticResource MethodChipCard}" Content="Tarjeta" Margin="0,0,4,0"
                                Command="{Binding SetMethodCommand}" CommandParameter="{x:Static enums:PaymentMethod.Card}" />
                        <Button Style="{StaticResource MethodChipTransfer}" Content="Transf." Margin="0,0,4,0"
                                Command="{Binding SetMethodCommand}" CommandParameter="{x:Static enums:PaymentMethod.Transfer}" />
                        <ToggleButton Style="{StaticResource CategoryChip}" Content="Mixto"
                                      IsChecked="{Binding IsMixed}" />
                    </UniformGrid>

                    <!-- Efectivo -->
                    <StackPanel Visibility="{Binding IsMixed, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMethod}" Value="Card">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedMethod}" Value="Transfer">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Monto recibido" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ReceivedText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                                     Padding="12,9" ToolTip="Monto recibido del cliente (F9 = exacto)" />
                            <Button Grid.Column="1" Content="Exacto (F9)" Margin="6,0,0,0"
                                    Command="{Binding SetExactAmountCommand}" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VUELTO" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ChangeAmount, StringFormat=RD$ {0:N2}}"
                                       FontSize="22" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </Grid>
                    </StackPanel>

                    <!-- Tarjeta / Transferencia -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMethod}" Value="Card">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedMethod}" Value="Transfer">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="{StaticResource MutedBrush}" CornerRadius="8" Padding="12,10">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Cobre " /><Run Text="{Binding Total, StringFormat=RD$ {0:N2}}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Run Text=" en el datáfono y confirme. El monto se registra manualmente." />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Mixto -->
                    <StackPanel Visibility="{Binding IsMixed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Efectivo" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding MixedCashText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                                 Padding="12,9" Margin="0,4,0,8" ToolTip="Monto a cobrar en efectivo" />
                        <TextBlock Text="Resto en" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <UniformGrid Columns="2" Margin="0,4,0,8">
                            <ToggleButton Style="{StaticResource CategoryChip}" Content="Tarjeta" Margin="0,0,4,0"
                                          IsChecked="{Binding MixedRemainderMethod, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Card}" />
                            <ToggleButton Style="{StaticResource CategoryChip}" Content="Transferencia"
                                          IsChecked="{Binding MixedRemainderMethod, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Transfer}" />
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resto a cobrar" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}">
                                <Run Text="RD$ " />
                                <Run Text="{Binding Total, StringFormat={}{0:N2}}" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Error -->
                    <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding PaymentError, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding PaymentError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Acciones -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Cancelar"
                                Command="{Binding ClosePaymentCommand}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Confirmar pago"
                                Background="{StaticResource AccentBrush}"
                                Command="{Binding ConfirmPaymentCommand}" />
                    </Grid>
                    <TextBlock Text="Procesando…" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Overlay: resultado ═══════════ -->
        <Grid Grid.RowSpan="2" Background="{StaticResource ScrimBrush}"
              Visibility="{Binding IsResultOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding NewSaleCommand}" />
            </Grid.InputBindings>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource PrimaryLightBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="{StaticResource CheckIcon}" Stroke="{StaticResource PrimaryBrush}"
                              StrokeThickness="3" Width="24" Height="24" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Venta completada" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,14">
                        <Run Text="Venta #" /><Run Text="{Binding LastSale.Number, StringFormat={}{0}}" />
                        <Run Text=" · " />
                        <Run Text="{Binding LastSale.CreatedAt, StringFormat=HH:mm}" />
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"
                               FontFamily="{StaticResource DisplayFont}" Margin="0,0,0,4">
                        <Run Text="RD$ " /><Run Text="{Binding LastSale.Total.Amount, StringFormat={}{0:N2}}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Vuelto: RD$ " /><Run Text="{Binding ChangeAmount, StringFormat={}{0:N2}}" />
                    </TextBlock>

                    <!-- Warnings (stock negativo) -->
                    <ItemsControl ItemsSource="{Binding LastSale.Warnings}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource WarningLightBrush}" CornerRadius="6"
                                        Padding="8,6" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource WarningBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Nueva venta  (Enter)" Height="46" FontSize="15" Margin="0,18,0,0"
                            Background="{StaticResource PrimaryBrush}"
                            Command="{Binding NewSaleCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
