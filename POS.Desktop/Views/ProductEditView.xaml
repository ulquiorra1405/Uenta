<UserControl x:Class="POS.Desktop.Views.ProductEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="480">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24" MaxWidth="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,20" />

        <!-- Formulario: el label se alinea con la PRIMERA LÍNEA del campo (Top + margen),
             no con la fila completa → siempre alineado con el textbox aunque el campo
             tenga margen inferior de espaciado. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre *" VerticalAlignment="Top" Margin="0,8,0,0" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="SKU" VerticalAlignment="Top" Margin="0,8,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Código de barras" VerticalAlignment="Top" Margin="0,8,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Categoría" VerticalAlignment="Top" Margin="0,8,0,0" />
            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Categories}"
                          SelectedValue="{Binding SelectedCategoryId}"
                          SelectedValuePath="Id" DisplayMemberPath="Name"
                          Padding="8,6" Margin="0,0,6,10" />
                <!-- Misma altura del combo (Height 30) y centrado → el + queda centrado -->
                <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Nueva categoría"
                        AutomationProperties.Name="NuevaCategoria"
                        Command="{Binding ToggleNewCategoryCommand}"
                        VerticalAlignment="Center" Height="30">
                    <Path Data="{StaticResource PlusIcon}" Stroke="{StaticResource TextPrimaryBrush}"
                          StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Nueva categoría rápida (inline, colapsable) -->
            <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                  Visibility="{Binding IsNewCategoryOpen, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" ToolTip="Nombre de la nueva categoría"
                         AutomationProperties.Name="NuevaCategoriaNombre" />
                <Button Grid.Column="1" Content="Crear" Margin="6,0,0,0" Padding="14,7" FontSize="12"
                        Command="{Binding CreateCategoryCommand}" AutomationProperties.Name="CrearCategoria" />
            </Grid>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Precio (ITBIS incl.)" VerticalAlignment="Top" Margin="0,8,0,0" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Costo (RD$)" VerticalAlignment="Top" Margin="0,8,0,0" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <!-- Margen en vivo -->
            <Grid Grid.Row="7" Grid.Column="1" Margin="0,6,0,10">
                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="10,7"
                        HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMargin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold">
                        <Run Text="Margen: RD$ " />
                        <Run Text="{Binding MarginAmount, Mode=OneWay, StringFormat={}{0:N2}}" />
                        <Run Text="  (" />
                        <Run Text="{Binding MarginPercent, Mode=OneWay, StringFormat={}{0:N1}}" />
                        <Run Text="%)" />
                    </TextBlock>
                </Border>
                <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="10,7"
                        HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMargin}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                               Text="El precio no cubre el costo" />
                </Border>
            </Grid>

            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Stock inicial" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Text" Value="Stock actual" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Al crear: campo editable de stock inicial -->
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Al editar: stock solo lectura + botón "Ajustar stock" (P3.2) -->
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{StaticResource MutedBrush}" CornerRadius="6" Padding="10,6"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stock, Converter={StaticResource NegConverter}}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LowStock}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Stock: " />
                        <Run Text="{Binding Stock, StringFormat={}{0:N0} uds}" />
                    </TextBlock>
                </Border>
                <Button Content="Ajustar stock" Command="{Binding OpenStockAdjustCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="12"
                        AutomationProperties.Name="AjustarStock" />
            </StackPanel>

            <!-- Panel de ajuste de stock (P3.2, colapsable) -->
            <Border Grid.Row="8" Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,0,0,10"
                    Visibility="{Binding IsStockAdjustOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Nuevo movimiento de inventario" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tipo" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding StockAdjustOptions}"
                                  SelectedValue="{Binding StockAdjustType}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  Padding="8,6" AutomationProperties.Name="TipoMovimiento" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cantidad" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Text="{Binding StockAdjustQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" AutomationProperties.Name="CantidadMovimiento" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Motivo *" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Text="{Binding StockAdjustReason, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" AutomationProperties.Name="MotivoMovimiento"
                                 ToolTip="Obligatorio: compra, merma, conteo, corrección…" />
                    </Grid>
                    <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="6"
                            Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                            Visibility="{Binding StockAdjustError, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding StockAdjustError}" Foreground="{StaticResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" />
                    </Border>
                    <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="6"
                            Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                            Visibility="{Binding StockAdjustMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding StockAdjustMessage}" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="11.5" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancelar" Command="{Binding CloseStockAdjustCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="12" />
                        <Button Content="Aplicar" Command="{Binding ApplyStockAdjustCommand}"
                                Padding="14,7" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                AutomationProperties.Name="AplicarMovimiento" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Stock mínimo" VerticalAlignment="Top" Margin="0,8,0,0" />
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <!-- Estado: activo/inactivo (solo en edición; al crear siempre nace activo) -->
            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <ToggleButton IsChecked="{Binding IsActive}"
                              AutomationProperties.Name="ToggleActivo" Padding="16,8">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource CategoryChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Activo" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                        <Setter Property="Text" Value="Inactivo" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Mensaje de error / aviso -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,10" CornerRadius="6"
                Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- Acciones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Duplicar" Command="{Binding DuplicateCommand}" Padding="20,8"
                    Style="{StaticResource SecondaryButton}"
                    ToolTip="Crea una copia como producto nuevo (SKU y stock propios)"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Padding="20,8" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}" />
            <Button Content="Guardar" Command="{Binding SaveCommand}" Padding="20,8"
                    Margin="8,0,0,0" FontWeight="SemiBold" IsDefault="True" />
        </StackPanel>
    </Grid>
</UserControl>