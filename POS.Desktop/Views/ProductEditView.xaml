<UserControl x:Class="POS.Desktop.Views.ProductEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="480">
    <Grid Margin="24" MaxWidth="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />

        <!-- Formulario -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre *" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="SKU" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Código de barras" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Categoría" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1"
                      ItemsSource="{Binding Categories}"
                      SelectedValue="{Binding SelectedCategoryId}"
                      SelectedValuePath="Id" DisplayMemberPath="Name"
                      Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Precio (RD$, ITBIS incl.)" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Costo (RD$)" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Stock inicial" VerticalAlignment="Center" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Stock mínimo" VerticalAlignment="Center" />
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,10" />
        </Grid>

        <!-- Mensaje de error / aviso -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,10" CornerRadius="4"
                Background="#FDECEC" BorderBrush="#E74C3C" BorderThickness="1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" TextWrapping="Wrap" />
        </Border>

        <!-- Acciones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Padding="20,8" />
            <Button Content="Guardar" Command="{Binding SaveCommand}" Padding="20,8"
                    Margin="8,0,0,0" FontWeight="SemiBold" IsDefault="True" />
        </StackPanel>
    </Grid>
</UserControl>
