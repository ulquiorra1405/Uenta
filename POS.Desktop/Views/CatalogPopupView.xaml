<UserControl x:Class="POS.Desktop.Views.CatalogPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:beh="clr-namespace:POS.Desktop.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="780">

    <UserControl.InputBindings>
        <!-- Vive en el MainWindow (fuera de SaleView): los atajos van aquí, no en la vista. -->
        <KeyBinding Key="Escape" Command="{Binding CancelOverlayCommand}" />
        <KeyBinding Key="F2" Command="{Binding OpenCatalogCommand}" />
    </UserControl.InputBindings>

    <Grid Style="{StaticResource OverlayScrim}"
          beh:OverlayAnimator.IsOpen="{Binding IsCatalogOpen}">
        <Border Style="{StaticResource DialogSurface}" Width="780" Height="580"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Título + cerrar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Catálogo" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="  —  agregar no cierra (F2)" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Cerrar (Esc)"
                            Command="{Binding CloseCatalogCommand}" AutomationProperties.Name="CerrarCatalogo">
                        <Path Data="{StaticResource CloseIcon}" Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- Buscador del catálogo -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <TextBox x:Name="CatalogSearchBox"
                             Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="38,10,12,10" FontSize="14"
                             AutomationProperties.Name="BuscarCatalogo"
                             PreviewKeyDown="CatalogSearchBox_PreviewKeyDown"
                             PreviewMouseLeftButtonDown="CatalogSearchBox_PreviewMouseLeftButtonDown"
                             ToolTip="Escanee un código de barras o escriba SKU/nombre">
                    </TextBox>
                    <Path Data="{StaticResource SearchIcon}" Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="2" Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Left" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>

                <!-- Categorías -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,10" HorizontalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding CategoryFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource CategoryChip}" Content="{Binding Name}"
                                              Margin="0,0,6,0" IsChecked="{Binding IsSelected}"
                                              Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Grid de productos -->
                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCard}" Width="176" Margin="0,0,10,10"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                               TextWrapping="Wrap" MaxHeight="36" />
                                                    <TextBlock Text="{Binding Sku}" FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <!-- Badge stock bajo -->
                                                <Border Background="{StaticResource WarningLightBrush}" CornerRadius="6"
                                                        Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LowStock}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Stock bajo" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="{StaticResource WarningBrush}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Price.Amount, StringFormat=RD$ {0:N2}}"
                                                       Style="{StaticResource MoneyText}" FontSize="16" Margin="0,8,0,0" />

                                            <Button Grid.Row="2" Content="+ AGREGAR" Margin="0,8,0,0" FontSize="11.5"
                                                    Padding="0,7"
                                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Estado vacío del catálogo -->
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Products.Count}" Value="0" />
                                            <Condition Binding="{Binding IsCatalogBusy}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Sin resultados" />
                        <Run Text=" — " />
                        <Run Text="{Binding CatalogSearchText, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CatalogStatus}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <!-- Feedback 3.4: agregados en esta apertura del popup -->
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6"
                                Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CatalogAdds}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDarkBrush}">
                                <Run Text="Agregados: " />
                                <Run Text="{Binding CatalogAdds}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cerrar  (Esc)" Padding="16,8"
                            Style="{StaticResource SecondaryButton}" Command="{Binding CloseCatalogCommand}"
                            AutomationProperties.Name="CerrarCatalogo"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>