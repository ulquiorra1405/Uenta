<UserControl x:Class="POS.Desktop.Views.RefundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:POS.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Devoluciones" Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Text="Notas de crédito por venta o sin recibo" FontSize="12.5"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,30,0,0" />

        <!-- Error de carga -->
        <Border Grid.Row="1" Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="12,10"
                Margin="0,10,0,0"
                Visibility="{Binding LoadError, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding LoadError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Paso 1: buscar recibo (o devolver sin recibo) -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="1 · Ventana original" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox Width="200" Text="{Binding ReceiptNumberText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="8,7" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="ReciboNumero"
                                     ToolTip="Número de recibo de la venta original" />
                            <Button Content="Buscar recibo" Style="{StaticResource SecondaryButton}" Padding="14,6"
                                    FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="BuscarRecibo"
                                    Command="{Binding SearchReceiptCommand}" />
                        </StackPanel>

                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="10,8"
                                Margin="0,8,0,0" Visibility="{Binding HasLoadedSale, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LoadedSaleText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                        </Border>

                        <TextBlock Text="{Binding ReceiptHint}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding CanRefundNoReceipt, Converter={StaticResource BoolToVis}}" />

                        <!-- Sin recibo: buscador de producto -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding CanRefundNoReceipt, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Sin recibo: agregue productos del catálogo" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBox Width="220" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" Padding="8,7" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="BuscarProductoDevolucion"
                                         ToolTip="Busque por nombre, SKU o código de barras" />
                                <TextBox Width="60" Text="{Binding ManualQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" Padding="8,7" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="CantidadProductoDevolucion" />
                                <Button Content="Agregar" Style="{StaticResource SecondaryButton}" Padding="14,6"
                                        FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                        AutomationProperties.Name="AgregarProductoDevolucion"
                                        Command="{Binding AddManualProductCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Paso 2: líneas a devolver -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="2 · Líneas a devolver" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <TextBlock Text="Busque un recibo o agregue productos para comenzar" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"
                                   Visibility="{Binding RefundLines.Count, Converter={StaticResource CollectionEmptyToVis}}" />

                        <ItemsControl ItemsSource="{Binding RefundLines}" Margin="0,6,0,0"
                                      Visibility="{Binding RefundLines.Count, Converter={StaticResource CollectionNotEmptyToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RefundLineItem}">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ProductName}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,1,0,0">
                                                    <Run Text="Precio RD$ " /><Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat={}{0:N2}}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0"
                                                        VerticalAlignment="Center">
                                                <TextBox Width="55" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12.5" Padding="6,4" VerticalContentAlignment="Center"
                                                         AutomationProperties.Name="CantidadLineaDevolucion" />
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="máx " /><Run Text="{Binding MaxQuantity, Mode=OneWay, StringFormat={}{0:0.##}}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="12.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="QuitarLineaDevolucion"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource CloseIcon}" Stroke="{StaticResource DangerBrush}"
                                                      StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Motivo (obligatorio sin recibo)" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Width="340"
                                         FontSize="13" Padding="8,7" Margin="0,3,0,0"
                                         AutomationProperties.Name="MotivoDevolucion"
                                         ToolTip="Requerido solo para devoluciones sin recibo" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                <TextBlock Text="Reembolso:" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <RadioButton Content="Efectivo" IsChecked="{Binding IsCashRefund}" FontSize="12.5"
                                             VerticalAlignment="Center" AutomationProperties.Name="ReembolsoEfectivo" />
                                <RadioButton Content="Tarjeta" IsChecked="{Binding IsCardRefund}" FontSize="12.5"
                                             Margin="10,0,0,0" VerticalAlignment="Center"
                                             AutomationProperties.Name="ReembolsoTarjeta" />
                            </StackPanel>
                        </Grid>

                        <!-- Error del formulario -->
                        <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="10,8"
                                Margin="0,10,0,0"
                                Visibility="{Binding FormError, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding FormError}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Paso 3: total + procesar -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Total a devolver" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalText}" FontSize="32" FontWeight="Bold"
                                       FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Procesar devolución" Height="44" Padding="22,0" FontSize="13.5"
                                VerticalAlignment="Center" Style="{StaticResource AccentButton}"
                                AutomationProperties.Name="ProcesarDevolucion"
                                Command="{Binding ProcessCommand}" />
                    </Grid>
                </Border>

                <!-- Historial -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Devoluciones recientes" FontSize="13.5" FontWeight="SemiBold"
                                   Margin="14,12,14,4" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RefundHistoryItem}">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" MinWidth="150">
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <Run Text="Nota #" /><Run Text="{Binding Number, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding CreatedAtText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UserName, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding KindText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Reason}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="280"
                                                           Visibility="{Binding Reason, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="13"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Popup resultado: devolución procesada -->
        <Grid Grid.Row="2" Visibility="{Binding IsResultOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource ScrimBrush}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}"
                    Padding="28" Width="420" Background="{StaticResource SurfaceBrush}">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource PrimaryLightBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="{StaticResource CheckIcon}" Stroke="{StaticResource PrimaryBrush}"
                              StrokeThickness="3" Width="22" Height="22" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Devolución procesada" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,14" Text="{Binding ResultSummaryText}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="Bold"
                               FontFamily="{StaticResource DisplayFont}" Margin="0,0,0,4"
                               Text="{Binding ResultTotalText}" />
                    <Button Content="Nueva devolución" Height="42" Margin="0,18,0,0" FontSize="13.5"
                            Style="{StaticResource AccentButton}"
                            AutomationProperties.Name="NuevaDevolucion"
                            Command="{Binding NewRefundCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>